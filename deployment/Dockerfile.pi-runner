FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 qemu-system-arm \
    && rm -rf /var/lib/apt/lists/*

COPY backend/tools/run_pi_boot.py /opt/hardware-tester/run_pi_boot.py
ENV TMPDIR=/var/tmp
USER 65532:65532
ENTRYPOINT ["python3", "/opt/hardware-tester/run_pi_boot.py"]

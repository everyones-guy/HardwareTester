# Base API endpoint for Flask backend
VITE_API_BASE=http://localhost:5000

# MQTT WebSocket broker URL
VITE_MQTT_BROKER=ws://localhost:9001

# Toggle whether to use frontend MQTT or delegate to backend
VITE_USE_FRONTEND_MQTT=true

# Optional UI feature flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENV_MODE=development
